# ============================================================================
# Punch Analytics -- one-click installer
#
# Generated by the dashboard installer endpoint. This file embeds the
# user's MCP API key in plaintext -- treat it like a password. Hand it
# to the user via a secure channel (Teams DM, signed email) and ask
# them to delete it after running.
#
#   user        : {{USERNAME}}
#   generated   : {{GENERATED_AT}}
#   server      : {{SERVER_URL}}
#   mcpb        : {{MCPB_VERSION}} ({{MCPB_URL}})
#   shim repo   : {{SHIM_REPO_URL}}
# ============================================================================

$ErrorActionPreference = 'Stop'

# Embedded by the supervisor at render time.
$Username     = '{{USERNAME}}'
$ApiKey       = '{{API_KEY}}'
$ServerUrl    = '{{SERVER_URL}}'
$McpbUrl      = '{{MCPB_URL}}'
$McpbVersion  = '{{MCPB_VERSION}}'
$ShimRepoUrl  = '{{SHIM_REPO_URL}}'

function Section($s){ Write-Host ""; Write-Host "=== $s ===" -ForegroundColor Cyan }
function OK($s)     { Write-Host "  [OK] $s" -ForegroundColor Green }
function Note($s)   { Write-Host "  $s" -ForegroundColor Gray }
function Warn($s)   { Write-Host "  [..] $s" -ForegroundColor Yellow }
function Fail($s)   { Write-Host "  [!!] $s" -ForegroundColor Red }
function PauseExit($code){
  Write-Host ""
  if($Host.Name -eq 'ConsoleHost'){ Read-Host "Press Enter to close this window" | Out-Null }
  exit $code
}

Write-Host ""
Write-Host "  Punch Analytics MCP installer" -ForegroundColor White
Write-Host "  user: $Username" -ForegroundColor White
Write-Host ""

# ----------------------------------------------------------------------------
# 1. Sanity checks
# ----------------------------------------------------------------------------
Section "Checking prerequisites"

# Claude Desktop. The MCPB extension format is Claude-Desktop-specific,
# so without it there's nothing to install into.
$claudeExe = Join-Path $env:LOCALAPPDATA "AnthropicClaude\Claude.exe"
if(-not (Test-Path $claudeExe)){
  $claudeExeAlt = Join-Path $env:LOCALAPPDATA "Programs\AnthropicClaude\Claude.exe"
  if(Test-Path $claudeExeAlt){ $claudeExe = $claudeExeAlt }
}
if(-not (Test-Path $claudeExe)){
  Fail "Claude Desktop not found."
  Note "Install it from https://claude.ai/download, then re-run this installer."
  PauseExit 1
}
OK "Claude Desktop found ($claudeExe)"

# We do NOT require admin. %APPDATA% and %TEMP% are writable as user.
if(([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)){
  Note "(running as Administrator -- not required, but harmless)"
}

# ----------------------------------------------------------------------------
# 2. Detect prior shim install
# ----------------------------------------------------------------------------
# Heuristic: %APPDATA%\Punch\backends.json exists -> the shim has run
# here before, so the MCPB extension is already registered with Claude
# Desktop. We then only refresh the key. If the dir is missing this is
# a clean machine and we install the MCPB.
$punchDir     = Join-Path $env:APPDATA "Punch"
$backendsFile = Join-Path $punchDir "backends.json"
$shimAlreadyInstalled = Test-Path $backendsFile

# ----------------------------------------------------------------------------
# 3. Write/merge backends.json with the new key
# ----------------------------------------------------------------------------
Section "Writing $backendsFile"

if(-not (Test-Path $punchDir)){
  New-Item -ItemType Directory -Path $punchDir -Force | Out-Null
}

# Read existing config so we preserve any extra backends the user
# might have added by hand. Bad JSON -> treat as missing (we're about
# to overwrite it anyway).
$existing = $null
if($shimAlreadyInstalled){
  try { $existing = Get-Content -Raw -LiteralPath $backendsFile | ConvertFrom-Json } catch { $existing = $null }
}

# Two backends share the same key + URL today: a single internal MCP
# endpoint federates SAP and Zabbix tools. Listed twice so the shim's
# tool-discovery treats them as logically separate namespaces (matches
# how the dashboard configures access per system).
function NewEntry($name){
  [ordered]@{
    name   = $name
    url    = $ServerUrl
    header = "X-Punch-Auth"
    key    = $ApiKey
  }
}

$desired = @{ "sap" = (NewEntry "sap"); "zabbix" = (NewEntry "zabbix") }

$merged = [ordered]@{}
if($existing -and $existing.backends){
  foreach($b in $existing.backends){
    if($b -and $b.name){ $merged[$b.name] = $b }
  }
}
foreach($k in $desired.Keys){ $merged[$k] = $desired[$k] }

$primary = "sap"
if($existing -and $existing.primary){ $primary = $existing.primary }

$config = [ordered]@{
  backends = @($merged.Values)
  primary  = $primary
}

# Atomic write: stage to .tmp then Move-Item -Force. Prevents a
# half-written file if the shim happens to be reading it concurrently
# (the shim's hot-reload watches mtime + tolerates parse errors).
$tmp = "$backendsFile.tmp"
$config | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $tmp -Encoding UTF8
Move-Item -Force -LiteralPath $tmp -Destination $backendsFile
OK "key written for sap + zabbix backends ($($merged.Count) backend(s) total)"

# ----------------------------------------------------------------------------
# 4. Install the MCPB extension if absent
# ----------------------------------------------------------------------------
if(-not $shimAlreadyInstalled){
  Section "Installing the Punch Analytics MCPB extension"
  Warn "Claude Desktop will pop up an 'Install Punch Analytics?' dialog."
  Note "Click Install. The dialog only appears the first time."

  $tmpMcpb = Join-Path $env:TEMP ("punch-analytics-" + $McpbVersion + ".mcpb")
  Note "Downloading $McpbUrl"
  try {
    Invoke-WebRequest -Uri $McpbUrl -OutFile $tmpMcpb -UseBasicParsing
  } catch {
    Fail "Download failed: $($_.Exception.Message)"
    Note "Check the URL is reachable from this network, then re-run."
    PauseExit 2
  }
  OK "Downloaded to $tmpMcpb"

  # Open the .mcpb -- Claude Desktop is registered as the file
  # association handler and will intercept + show the install prompt.
  Start-Process -FilePath $tmpMcpb
  Note "Once you click Install in the dialog, restart Claude Desktop."
  Note "After the restart, Punch Analytics tools appear in the tool palette."
} else {
  Section "Activating the new key"
  OK "MCPB extension already installed."
  Note "The shim hot-reloads keys within ~2 seconds -- no Claude Desktop restart needed."
  Note "If tools still 401 after a few seconds, restart Claude Desktop to force a fresh shim launch."
}

# ----------------------------------------------------------------------------
# 5. Done
# ----------------------------------------------------------------------------
Section "Installer finished"
OK "All done for $Username."
Note ""
Note "Next:"
if(-not $shimAlreadyInstalled){
  Note "  1. Approve the 'Install Punch Analytics?' dialog in Claude Desktop."
  Note "  2. Restart Claude Desktop."
  Note "  3. Try a tool, e.g. 'list my SAP company codes'."
} else {
  Note "  1. Try a tool in Claude Desktop, e.g. 'list my SAP company codes'."
  Note "     (No restart required -- the shim picks up the new key automatically.)"
}
Note ""
Note "This installer file embeds your API key in plaintext."
Note "Delete it now: del `"$PSCommandPath`""

PauseExit 0
