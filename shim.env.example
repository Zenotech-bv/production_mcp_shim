# Punch Analytics shim — laptop-side environment template
#
# As of shim v3.0.0+ humans do NOT need a key. The default flow is:
#   1. Install the .mcpb via Claude Desktop. Leave the API key field blank.
#   2. The shim auto-seeds %APPDATA%\Punch\backends.json with auth=negotiate.
#   3. Open Claude Desktop. Tools work — your Windows logon ticket is the
#      credential.
#
# The variables below are only relevant for two narrow cases:
#   (a) You're installing for a SERVICE IDENTITY (a headless bot / webhook
#       that can't carry a Kerberos ticket). Set PUNCH_SAP_KEY to the
#       service-account key the admin gave you.
#   (b) You're overriding the default server URL for a staging / forked
#       deployment.
#
# Otherwise: do nothing. Don't even create shim.env. The defaults are right.

# ----- Service-identity override (uncomment + fill for a headless caller) -----
# PUNCH_SAP_KEY=REPLACE_WITH_SERVICE_ACCOUNT_KEY

# ----- Server URL override (uncomment + edit for a fork / staging deploy) -----
# PUNCH_SAP_URL=http://ai.punchpowertrain.com:3000

# ----- Request timeout -----
# How long to wait for a single tool call before giving up. Default 300s
# (v2.1.1+ — composer / fan-out / range-chunking can legitimately take
# minutes on PPS-class company codes). Reduce only if you know your
# queries are small and want fast failure.
# PUNCH_SAP_TIMEOUT=300

# ----- TLS verification -----
# Set to "false" only if the server is HTTPS with Punch's internal CA and
# that CA is NOT in your laptop's trust store. Prefer importing the CA.
# PUNCH_SAP_VERIFY_TLS=true

# ----- Auto-update shim from GitHub -----
# Default "1" (enabled). The shim checks the canonical GitHub repo on
# every Claude Desktop startup and applies any newer shim_server.py
# (sha256-verified before the atomic swap). Set to "0" only on locked-
# down networks that can't reach raw.githubusercontent.com.
# PUNCH_SHIM_AUTO_UPDATE=1

# ----- Debug logging -----
# Set to "1" for DEBUG-level shim logs (audit log location:
# %LOCALAPPDATA%\PunchAnalytics\shim.log).
# PUNCH_SHIM_DEBUG=0
